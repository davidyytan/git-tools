# Example workflow for the release-led Git Flow variant.
#
# SETUP — do this in YOUR GitHub application repository.
# Copy this file to .github/workflows/version-bump-git-flow-variant-release-led.yml.
# Enable only ONE versioning workflow; reviewed release-led uses this same file.
#
# ALREADY HAVE KEYS? Run these locally, ONE AT A TIME, then paste each output:
# Destination: your repo > Settings > Secrets and variables > Actions > New repository secret.
# Select your dedicated automation key from the first command, then replace YOUR_GPG_KEY_ID with its long ID/full fingerprint and use your own SSH filename.
#
#   gpg --list-secret-keys --keyid-format=long
#   gpg --export-secret-key -a YOUR_GPG_KEY_ID  # -> secret BOT_GPG_SECRETKEY
#   cat "$HOME/.ssh/YOUR_AUTOMATION_SSH_KEY"   # -> secret BOT_SSH_SECRETKEY (NOT .pub)
#
# Paste the COMPLETE private-key blocks, including BEGIN/END markers.
# No export file needed. Use a private, unrecorded terminal; never paste keys into YAML, source files, chat, or logs. Terminal/clipboard history can retain them.
# These steps have no GPG/SSH passphrase configured; protected keys need adaptation.
# Already registered the public keys and write access? Skip the optional steps below.
#
# NEED A KEY? Create ONLY the missing key locally, with your own automation identity:
#   gpg --full-generate-key
#     Choose a signing-capable key, expiry, and YOUR automation name/email.
#   mkdir -p "$HOME/.ssh"
#   ssh-keygen -t ed25519 -C 'YOUR_AUTOMATION_EMAIL' -f "$HOME/.ssh/git_tools_bot_ed25519"
#     Never overwrite an existing key; choose another filename if needed.
# Only if your policy permits unattended keys, leave the NEW automation keys' passphrases empty (SSH: Enter twice). Never strip protection from a personal key.
# Then use the SAME list/export/cat block above with the new key ID/SSH filename.
#
# PUBLIC KEYS — register only if not already configured (these are NOT secrets):
#   gpg --export -a YOUR_GPG_KEY_ID
#     -> signing account > Settings > SSH and GPG keys > New GPG key.
#   cat "$HOME/.ssh/YOUR_AUTOMATION_SSH_KEY.pub"
#     -> your repo > Settings > Deploy keys > Add deploy key > Allow write access, OR your own bot account's SSH authentication keys with repo write access.
# Never put a private key on a public-key registration screen.
#
# EDIT env BELOW: use YOUR automation GIT_BOT_NAME / GIT_BOT_EMAIL, not David's.
# The email must match the GPG identity and a verified email on the signing account.
# Use your own GitHub owner/repo for the APPLICATION remote; keep GIT_TOOLS_REPO as the upstream tool source unless intentionally using your own git-tools fork.
# Verify GIT_TOOLS_REF is a supported branch/tag; local CLI updates do not update it.
# Allow this SSH identity to push signed commits/tags through your branch rules.
# For PR merges, use the PR title as the final commit subject; disable rebase merge.
# Full process, branch policy, bootstrap, and recovery: docs/github/setup.md and docs/github/release-led-walkthrough.md in the git-tools source repository.
#
# VERSION POLICY:
# - develop -> tagged alpha prereleases
# - release/<x.y.z> chooses the target release line, then rc prereleases stay locked to it
# - master -> stable releases
# - hotfix/** -> patch rc prereleases, then stable on master
# - release/** and hotfix/** may also merge into develop; if develop is already ahead it preserves that alpha line and may advance alpha when meaningful unique fixes land there
# - if develop is not ahead yet, those backmerges may catch develop up to the promoted stable target without tagging

name: Version Bump (Variant)

on:
  push:
    branches:
      - master
      - develop
      - "release/**"
      - "hotfix/**"
      - "feature/**"
      - "bugfix/**"
  workflow_dispatch:

env:
  # Set to 'false' here to bump only .cz.toml (default enabled).
  GIT_TOOLS_BUMP_SYNC_AUXILIARY: 'true'
  GIT_TOOLS_REPO: https://github.com/davidyytan/git-tools.git
  GIT_TOOLS_REF: develop
  GIT_BOT_NAME: YOUR_AUTOMATION_NAME # Replace with your dedicated automation Git name.
  GIT_BOT_EMAIL: YOUR_AUTOMATION_EMAIL # Match your GPG key and verified signing-account email.

jobs:
  version-bump:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0
          persist-credentials: true
          ssh-key: ${{ secrets.BOT_SSH_SECRETKEY }}

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Clone git-tools
        run: |
          git clone --branch "$GIT_TOOLS_REF" "$GIT_TOOLS_REPO" "$RUNNER_TEMP/git-tools"

      - name: Decide version strategy
        id: strategy
        env:
          BRANCH_NAME: ${{ github.ref_name }}
        run: |
          PYTHONPATH="$RUNNER_TEMP/git-tools" python - <<'PY'
          import os
          from pathlib import Path

          from git_tools.generators.bumpgen import decide_version_strategy, write_github_output

          write_github_output(
              Path(os.environ["GITHUB_OUTPUT"]),
              decide_version_strategy(
                  Path.cwd(),
                  os.environ["BRANCH_NAME"],
                  flow="variant",
              ),
          )
          PY

      - name: Show decision
        env:
          DECISION_BRANCH: ${{ steps.strategy.outputs.branch }}
          DECISION_SKIP: ${{ steps.strategy.outputs.skip }}
          DECISION_INVALID: ${{ steps.strategy.outputs.invalid }}
          DECISION_MODE: ${{ steps.strategy.outputs.mode }}
          DECISION_REASON: ${{ steps.strategy.outputs.reason }}
          DECISION_ERROR: ${{ steps.strategy.outputs.error }}
          DECISION_RELEASE_TARGET: ${{ steps.strategy.outputs.release_target }}
          DECISION_RELEASE_INCREMENT: ${{ steps.strategy.outputs.release_increment }}
          DECISION_HOTFIX_TARGET: ${{ steps.strategy.outputs.hotfix_target }}
          DECISION_CURRENT_VERSION: ${{ steps.strategy.outputs.current_version }}
          DECISION_CURRENT_RELEASE_LINE: ${{ steps.strategy.outputs.current_release_line }}
          DECISION_MASTER_VERSION: ${{ steps.strategy.outputs.master_version }}
          DECISION_MASTER_RELEASE_LINE: ${{ steps.strategy.outputs.master_release_line }}
          DECISION_BOOTSTRAP_COMMITIZEN_VERSION_OK: ${{ steps.strategy.outputs.bootstrap_commitizen_version_ok }}
          DECISION_BOOTSTRAP_SUBJECT_OK: ${{ steps.strategy.outputs.bootstrap_subject_ok }}
          DECISION_CURRENT_IS_PRERELEASE: ${{ steps.strategy.outputs.current_is_prerelease }}
          DECISION_BUMP_ELIGIBLE: ${{ steps.strategy.outputs.bump_eligible }}
          DECISION_BRANCH_GATE_REF: ${{ steps.strategy.outputs.branch_gate_ref }}
          DECISION_BRANCH_HAS_UNIQUE_COMMITS: ${{ steps.strategy.outputs.branch_has_unique_commits }}
          DECISION_CREATE_TAG: ${{ steps.strategy.outputs.create_tag }}
          DECISION_SUBJECT: ${{ steps.strategy.outputs.subject }}
        run: |
          python - <<'PY'
          import json
          import os
          for key in sorted(os.environ):
              if key.startswith("DECISION_"):
                  print(f"{key[9:].lower()}={json.dumps(os.environ[key], ensure_ascii=True)}")
          PY

      - name: Fail invalid release branch configuration
        if: steps.strategy.outputs.invalid == 'true'
        env:
          DECISION_ERROR: ${{ steps.strategy.outputs.error }}
        run: |
          python - <<'PY'
          import json
          import os
          print("Decision error: " + json.dumps(os.environ["DECISION_ERROR"], ensure_ascii=True))
          PY
          exit 1

      - name: Import GPG key
        if: steps.strategy.outputs.skip != 'true' && steps.strategy.outputs.invalid != 'true'
        uses: crazy-max/ghaction-import-gpg@v6
        with:
          gpg_private_key: ${{ secrets.BOT_GPG_SECRETKEY }}
          trust_level: 5
          git_user_signingkey: true
          git_commit_gpgsign: true
          git_tag_gpgsign: true
          git_config_global: true

      - name: Run version bump
        if: steps.strategy.outputs.skip != 'true' && steps.strategy.outputs.invalid != 'true'
        env:
          EDITOR: vi
          BUMP_ARGS: ${{ steps.strategy.outputs.args }}
        run: |
          git config --local user.name "$GIT_BOT_NAME"
          git config --local user.email "$GIT_BOT_EMAIL"
          git fetch --force --tags origin

          PYTHONPATH="$RUNNER_TEMP/git-tools" python - <<'PY'
          import os
          import shlex
          import subprocess
          import sys
          subprocess.run([sys.executable, "-m", "git_tools.generators.bumpgen", *shlex.split(os.environ["BUMP_ARGS"])], check=True)
          PY

      - name: Push changes
        if: steps.strategy.outputs.skip != 'true' && steps.strategy.outputs.invalid != 'true'
        env:
          BRANCH_NAME: ${{ github.ref_name }}
          CREATE_TAG: ${{ steps.strategy.outputs.create_tag }}
        run: |
          PYTHONPATH="$RUNNER_TEMP/git-tools" python -m git_tools.generators.publish --branch "$BRANCH_NAME" --create-tag "$CREATE_TAG"
