# Git Tools Configuration
# Copy to git-tools.env in the working directory, then uncomment desired values.
# Do not commit credentials. Process env overrides ~/.git-tools/settings.env,
# which overrides this local file; see docs/configuration.md for legacy sources.
# Model IDs below are repository defaults/examples, not availability guarantees.
# Known endpoint/reset/Kimi picker defects: docs/configuration.md#current-limitations.

# ====== LLM PROVIDER ======
# Provider: "openrouter", "kimicli", "cliproxyapi", "acrc", "copilot", "qwen",
# "openai", "anthropic" (alias claude).
# (`kimicode` and `kimi` are accepted aliases for `kimicli`.)
# Live /models drives OpenRouter, Kimi, CLIProxyAPI, Copilot, ACRC, OpenAI and Anthropic
# model pickers, resolved as agent-cli does it. ACRC, OpenAI and Anthropic fall back to
# built-in lists; Copilot falls back to gpt-4.1. OpenRouter and CLIProxyAPI have no built-in list.
# Kimi may show a warned last-known-good catalog scoped to endpoint + credential fingerprint.
# Qwen uses curated choices. Saved/manual IDs are accepted for all providers;
# the endpoint determines whether an ID is available.
# Settings saves provider profiles: model, support, effort, Kimi thinking,
# OpenRouter pin and custom endpoint are mirrored to GIT_TOOLS_<PROVIDER>_* /
# <PROVIDER>_BASE_URL keys. Restoration is intended on provider switches, but the
# documented endpoint-reset and Kimi picker gaps mean it is not lossless.
# Uncomment ONE provider section below and keep only the matching
# GIT_TOOLS_MODEL_MAIN override enabled if you set one.
# Default provider:
# GIT_TOOLS_PROVIDER=openrouter

# --- OpenRouter provider ---
# 1. Get API key from https://openrouter.ai/keys
# 2. Uncomment OPENROUTER_API_KEY and optionally leave provider as openrouter
# The picker loads OpenRouter's live model catalog; any model ID can also be
# entered manually (manual IDs are saved as model settings, not a catalog list).
# The repository default is deepseek/deepseek-v4-flash-0731.
# OPENROUTER_API_KEY=sk-or-...
# GIT_TOOLS_API_BASE=https://openrouter.ai/api/v1
# GIT_TOOLS_DEFAULT_MODEL=deepseek/deepseek-v4-flash-0731

# --- Kimi Code provider (via Kimi CLI endpoint) ---
# 1. Get API key from Kimi Code membership page (sk-kimi-... format)
# 2. Uncomment KIMICODE_API_KEY and set GIT_TOOLS_PROVIDER=kimicli
# KIMICODE_API_KEY=sk-kimi-...
# GIT_TOOLS_API_BASE=https://api.kimi.com/coding/v1
# GIT_TOOLS_MODEL_MAIN=kimi-for-coding
# Catalog mode takes precedence: thinking-only forces on, no-thinking forces off.
# Otherwise explicit false disables thinking and suppresses effort; a non-none
# effort alone enables thinking. Without a catalog mandate or either setting,
# no thinking override is sent.
# The current picker can change a saved effective effort by accepting its default;
# see docs/configuration.md#current-limitations.
# GIT_TOOLS_KIMI_THINKING=false

# --- CLIProxyAPI provider (local OpenAI-compatible proxy) ---
# 1. Run CLIProxyAPI and authenticate it (e.g. codex login); default port 8317.
# 2. Set GIT_TOOLS_PROVIDER=cliproxyapi. The client key defaults to "cliproxyapi"
#    (the placeholder the proxy ships with), so CLIPROXYAPI_API_KEY is optional —
#    set it only if your proxy uses a different key. Repo default: gpt-6-astra.
#    Its live model picker lists what the endpoint currently serves (no
#    built-in list, as in agent-cli).
# GIT_TOOLS_PROVIDER=cliproxyapi
# CLIPROXYAPI_API_KEY=cliproxyapi   # optional; defaults to "cliproxyapi"
# GIT_TOOLS_API_BASE=http://127.0.0.1:8317/v1
# GIT_TOOLS_MODEL_MAIN=gpt-6-astra
# Effort is forwarded to OpenAI-family IDs not on the non-reasoning denylist;
# it is omitted when unset/none. The endpoint decides which tiers it accepts.
# GIT_TOOLS_REASONING_EFFORT=xhigh
# GIT_TOOLS_DEFAULT_TEMPERATURE is sent to every proxied model; endpoint/model
# support must be checked separately.

# --- ACRC (VPN/connectivity managed externally) ---
# GIT_TOOLS_PROVIDER=acrc
# ACRC_API_KEY=your-key
# GIT_TOOLS_API_BASE=https://fmodel.ai.acrc.a-star.edu.sg/v1
# GIT_TOOLS_MODEL_MAIN=deepseek-v4.1-flash

# --- Copilot OpenAI-compatible proxy (run/authenticate it separately) ---
# GIT_TOOLS_PROVIDER=copilot
# COPILOT_API_KEY=your-key
# GIT_TOOLS_API_BASE=http://127.0.0.1:4141/v1
# GIT_TOOLS_MODEL_MAIN=exact-model-id-from-your-proxy

# --- OpenAI platform (chat completions; live /models narrowed to chat models) ---
# A configured non-none effort is sent unless the ID matches the repository's
# non-reasoning denylist (gpt-3*, gpt-4*, chatgpt-*, *-chat*, o1-mini/preview).
# For other IDs, temperature is omitted. This is a code-level classification,
# not a guarantee of endpoint/model compatibility. "none" omits effort.
# GIT_TOOLS_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# GIT_TOOLS_API_BASE=https://api.openai.com/v1
# GIT_TOOLS_MODEL_MAIN=gpt-6-astra
# GIT_TOOLS_REASONING_EFFORT=high

# --- Anthropic via its OpenAI-compatible endpoint (alias: claude) ---
# This client omits temperature. Effort "none" sends thinking.type=disabled;
# other configured effort tiers are forwarded, otherwise thinking is omitted.
# Server behavior is endpoint/model-dependent. The picker reads the native Models
# API; generation uses the OpenAI-compatible chat-completions transport.
# GIT_TOOLS_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# GIT_TOOLS_API_BASE=https://api.anthropic.com/v1
# GIT_TOOLS_MODEL_MAIN=claude-opus-5-5
# GIT_TOOLS_REASONING_EFFORT=high

# --- Qwen / DashScope: exact endpoint REQUIRED; do not guess plan/region ---
# GIT_TOOLS_PROVIDER=qwen
# DASHSCOPE_API_KEY=your-key
# GIT_TOOLS_API_BASE=https://your-plan-region-endpoint/compatible-mode/v1
# GIT_TOOLS_MODEL_MAIN=qwen3.8-max

# Main is used for every generation. Support/sub is reserved and UNUSED today.
# GIT_TOOLS_MODEL_SUPPORT=follow-main
# GIT_TOOLS_DEFAULT_MODEL is a legacy main-model alias; source precedence wins first.
# Within the same source, MODEL_MAIN takes precedence.
# OpenRouter upstream slug, or any for unpinned routing:
# GIT_TOOLS_OPENROUTER_PROVIDER=any

# ====== GIT TOOLS SETTINGS ======
# Uncomment only when overriding the default value.

# LLM defaults
# Provider metadata and model lists are defined in code (git_tools/providers/,
# wired into the registry in git_tools/settings/mappings.py).
# Provider-specific model examples are shown in the provider sections above.
# GIT_TOOLS_DEFAULT_TEMPERATURE=0.6
# GIT_TOOLS_DEFAULT_MAX_TOKENS=32000
# GIT_TOOLS_DEFAULT_MAX_RETRIES=1
# GIT_TOOLS_DEFAULT_RETRY_DELAY=1.0

# Saved INPUT diff-processing budgets (separate from maximum OUTPUT tokens above).
# Applied without routine prompts; --token-limit overrides one run.
# GIT_TOOLS_DEFAULT_TOKEN_LIMIT=200000
# GIT_TOOLS_DEFAULT_ISSUE_PR_TOKEN_LIMIT=200000
# GIT_TOOLS_LARGE_DIFF_THRESHOLD=5000

# Stable content preferences; modes apply them, CLI flags override one run.
# Settings -> Commit format groups scope/body/style/footer; the short summary
# is always required. Body means the optional multiline text below that summary.
# Scope/footer default off; body defaults on with point-form (bullets) details.
# Body style: bullets or prose. Style is retained while body is off.
# These rules apply to provider and prepared local prompts, not the fixed
# chore: open release subject. Issue/PR source: d=diffs, c=messages, b=both.
# GIT_TOOLS_COMMIT_INCLUDE_SCOPE=false
# GIT_TOOLS_COMMIT_INCLUDE_BODY=true
# GIT_TOOLS_COMMIT_BODY_STYLE=bullets
# GIT_TOOLS_COMMIT_INCLUDE_FOOTER=false
# GIT_TOOLS_ISSUE_PR_SOURCE=b

# Files below this token count are never dropped during context limiting
# GIT_TOOLS_MIN_FILE_TOKEN_THRESHOLD=1000

# Console width offset to prevent border wrapping (Rich issue #7)
# GIT_TOOLS_CONSOLE_WIDTH_OFFSET=-2

# Local/uv bump override (default true; overrides .cz.toml sync_auxiliary).
# For CI, edit this setting directly in the workflow YAML instead.
# false selects only .cz.toml for updates, skipping pyproject/uv/npm/Cargo/custom
# targets. It does not prevent metadata snapshots: a nonregular metadata path
# can still hang planning. See docs/versioning.md#current-limitations.
# Strict boolean: true/false, 1/0, yes/no, on/off (case-insensitive).
# This does not disable version calculation, commits, tags, or publication.
# GIT_TOOLS_BUMP_SYNC_AUXILIARY=true

# Azure PR preferences (also editable via git-tools settings).
# Mode: auto detects Azure origin and applies it without a routine question;
# false disables automatic limiting. No saved true mode.
# GIT_TOOLS_AZURE_PR_LIMIT=auto
# Preferred generated description length, 1–4000 UTF-16 units (default 4000).
# GIT_TOOLS_AZURE_PR_MAX_CHARS=4000
