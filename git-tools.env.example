# Git Tools Configuration

# ====== LLM PROVIDER ======
# Provider: "openrouter", "kimicode" (alias kimicli), "cliproxyapi", "acrc", "copilot", "qwen",
# "openai", "anthropic" (alias claude)
# (`kimicode` and `kimi` are accepted aliases for `kimicli`.)
# Live /models drives OpenRouter, Kimi, CLIProxyAPI, Copilot, ACRC, OpenAI and Anthropic
# model pickers, resolved as agent-cli does it; ACRC, OpenAI and Anthropic fall back to
# their built-in lists when the endpoint is unreachable, the rest show only what is served.
# Qwen uses curated choices (its catalog varies by plan/region). Manual IDs work for all.
# Kimi's last-known-good catalog is cached by endpoint + credential fingerprint.
# Each provider keeps a profile: model, support, effort, Kimi thinking, OpenRouter pin
# and a custom endpoint are mirrored to GIT_TOOLS_<PROVIDER>_* / <PROVIDER>_BASE_URL keys
# when saved, and restored when you switch back to that provider.
# Uncomment ONE provider section below and keep only the matching
# GIT_TOOLS_MODEL_MAIN override enabled if you set one.
# Default provider:
# GIT_TOOLS_PROVIDER=openrouter

# --- OpenRouter provider ---
# 1. Get API key from https://openrouter.ai/keys
# 2. Uncomment OPENROUTER_API_KEY and optionally leave provider as openrouter
# The picker loads OpenRouter's live model catalog; any model ID can also be
# entered manually (only the saved main model is remembered). Defaults to
# deepseek/deepseek-v4-flash-0731 (agent-cli's default).
# OPENROUTER_API_KEY=sk-or-...
# GIT_TOOLS_API_BASE=https://openrouter.ai/api/v1
# GIT_TOOLS_DEFAULT_MODEL=deepseek/deepseek-v4-flash-0731

# --- Kimi Code provider (via Kimi CLI endpoint) ---
# 1. Get API key from Kimi Code membership page (sk-kimi-... format)
# 2. Uncomment KIMICODE_API_KEY and set GIT_TOOLS_PROVIDER=kimicli
# KIMICODE_API_KEY=sk-kimi-...
# GIT_TOOLS_API_BASE=https://api.kimi.com/coding/v1
# GIT_TOOLS_MODEL_MAIN=kimi-for-coding
# Explicit false wins over GIT_TOOLS_REASONING_EFFORT (no tier is sent or checked);
# unset sends nothing, so Kimi applies the model default (as in agent-core).
# GIT_TOOLS_KIMI_THINKING=false

# --- CLIProxyAPI provider (local Codex/GPT-5 proxy) ---
# 1. Run CLIProxyAPI and authenticate it (e.g. codex login); default port 8317.
# 2. Set GIT_TOOLS_PROVIDER=cliproxyapi. The client key defaults to "cliproxyapi"
#    (the placeholder the proxy ships with), so CLIPROXYAPI_API_KEY is optional —
#    set it only if your proxy uses a different key. Defaults to model gpt-6-astra.
#    Its live model picker lists what the endpoint currently serves (no
#    built-in list, as in agent-cli).
# GIT_TOOLS_PROVIDER=cliproxyapi
# CLIPROXYAPI_API_KEY=cliproxyapi   # optional; defaults to "cliproxyapi"
# GIT_TOOLS_API_BASE=http://127.0.0.1:8317/v1
# GIT_TOOLS_MODEL_MAIN=gpt-6-astra
# Reasoning effort for reasoning models (e.g. low, medium, high, xhigh); nothing
# is sent when unset, as in agent-core:
# GIT_TOOLS_REASONING_EFFORT=xhigh
# GIT_TOOLS_DEFAULT_TEMPERATURE is sent to every proxied model (the proxy accepts it).

# --- ACRC (VPN/connectivity managed externally) ---
# GIT_TOOLS_PROVIDER=acrc
# ACRC_API_KEY=your-key
# GIT_TOOLS_API_BASE=https://fmodel.ai.acrc.a-star.edu.sg/v1
# GIT_TOOLS_MODEL_MAIN=deepseek-v4.1-flash

# --- Copilot OpenAI-compatible proxy (run/authenticate it separately) ---
# GIT_TOOLS_PROVIDER=copilot
# COPILOT_API_KEY=your-key
# GIT_TOOLS_API_BASE=http://127.0.0.1:4141/v1
# GIT_TOOLS_MODEL_MAIN=exact-model-id-from-your-proxy

# --- OpenAI platform (chat completions; live /models narrowed to chat models) ---
# Reasoning effort is sent to every model except those known to reject it
# (gpt-3.5, gpt-4.x/4o, chatgpt-*, *-chat variants, o1-mini/preview), so a new
# model gets it on day one; reasoning models also use the server's default
# temperature. "none" sends nothing (server default).
# GIT_TOOLS_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# GIT_TOOLS_API_BASE=https://api.openai.com/v1
# GIT_TOOLS_MODEL_MAIN=gpt-6-astra
# GIT_TOOLS_REASONING_EFFORT=high

# --- Anthropic via its OpenAI-compatible endpoint (alias: claude) ---
# Temperature is never sent (Claude 4.7+ rejects values below 1). Thinking is
# adaptive by default; effort "none" turns it off, other tiers are forwarded but
# Anthropic's compatibility layer currently ignores them. The model picker reads
# the native Models API.
# GIT_TOOLS_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# GIT_TOOLS_API_BASE=https://api.anthropic.com/v1
# GIT_TOOLS_MODEL_MAIN=claude-opus-5-5
# GIT_TOOLS_REASONING_EFFORT=high

# --- Qwen / DashScope: exact endpoint REQUIRED; do not guess plan/region ---
# GIT_TOOLS_PROVIDER=qwen
# DASHSCOPE_API_KEY=your-key
# GIT_TOOLS_API_BASE=https://your-plan-region-endpoint/compatible-mode/v1
# GIT_TOOLS_MODEL_MAIN=qwen3.8-max

# Main is used for every generation. Support/sub is reserved and UNUSED today.
# GIT_TOOLS_MODEL_SUPPORT=follow-main
# GIT_TOOLS_DEFAULT_MODEL remains a legacy fallback when MODEL_MAIN is unset.
# OpenRouter upstream slug, or any for unpinned routing:
# GIT_TOOLS_OPENROUTER_PROVIDER=any

# ====== GIT TOOLS SETTINGS ======
# Uncomment only when overriding the default value.

# LLM defaults
# Provider metadata and model lists are defined in code (git_tools/providers/,
# wired into the registry in git_tools/settings/mappings.py).
# Provider-specific model examples are shown in the provider sections above.
# GIT_TOOLS_DEFAULT_TEMPERATURE=0.6
# GIT_TOOLS_DEFAULT_MAX_TOKENS=32000
# GIT_TOOLS_DEFAULT_MAX_RETRIES=1
# GIT_TOOLS_DEFAULT_RETRY_DELAY=1.0

# Token limits for diff processing
# GIT_TOOLS_DEFAULT_TOKEN_LIMIT=200000
# GIT_TOOLS_DEFAULT_ISSUE_PR_TOKEN_LIMIT=200000
# GIT_TOOLS_LARGE_DIFF_THRESHOLD=5000

# Files below this token count are never dropped during context limiting
# GIT_TOOLS_MIN_FILE_TOKEN_THRESHOLD=1000

# Console width offset to prevent border wrapping (Rich issue #7)
# GIT_TOOLS_CONSOLE_WIDTH_OFFSET=-2

# Local/uv bump override (default true; overrides .cz.toml sync_auxiliary).
# For CI, edit this setting directly in the workflow YAML instead.
# false updates only .cz.toml, skipping pyproject/uv/npm/Cargo/custom targets.
# Strict boolean: true/false, 1/0, yes/no, on/off (case-insensitive).
# This does not disable version calculation, commits, tags, or publication.
# GIT_TOOLS_BUMP_SYNC_AUXILIARY=true

# Azure PR preferences (also editable via git-tools settings).
# Mode: auto detects Azure origin; false disables automatic limiting. No saved true mode.
# GIT_TOOLS_AZURE_PR_LIMIT=auto
# Preferred generated description length, 1–4000 UTF-16 units (default 4000).
# GIT_TOOLS_AZURE_PR_MAX_CHARS=4000
